function proyecto2_routh_rootlocus
% Codigo de simulación para el proyecto 1 (extendido para proyecto 2)

% ---------------------------------------- ENCABEZADO ------------------------------------------------------------
disp("_____________________________________________________________________________________");
disp("                                                                                     ");
disp("                                SIMULADOR DE MOTOR DE CD                             ");
disp("_____________________________________________________________________________________");

disp("Ingresa los siguientes datos para la generación del grafico");
disp("                                                                                     ");

% ---------------------------------------- ENTRADA DE PARÁMETROS ---------------------------
constante_par = input('Ingrese la Constante de par [N.m/A]: ');
resistencia_armadura = input('Ingrese la Resistencia de armadura [Ohms]: ');
friccion_eje = input('Ingrese la Fricción del eje [N.m.s/rad]: ');
constante_fem = input('Ingrese la Constante fem [V.s/rad]: ');
momento_inercia = input('Ingrese el Momento de inercia [kg.m^2]: ');

% ---------------------------------------- VALIDACIONES ---------------------------------------------------------
if resistencia_armadura <= 0 || momento_inercia <= 0
    error('Error :c : No es posible hacerlo con esos datos, ingresa datos nuevos, porfavor. Nota: Se debe a que la resistencia y la inercia deben ser mayores a cero. :(');
end

if constante_par < 0 || constante_fem < 0 || friccion_eje < 0
    error('Error :c : No es posible hacerlo con esos datos, ingresa datos nuevos, por favor. Nota: Se debe a que los parámetros no pueden ser negativos.');
end

% ---------------------------------------- CÁLCULOS DEL MODELO (K_M y tau) -----------------------------------------
denominador_comun = (resistencia_armadura * friccion_eje) + (constante_par * constante_fem);
if denominador_comun == 0
    error('Error :c : No es posible hacerlo con esos datos, ingresa datos nuevos. El denominador común es cero.');
end

ganancia_motor = constante_par / denominador_comun;                       % K_M
constante_tiempo = (resistencia_armadura * momento_inercia) / denominador_comun; % tau

% Mostrar resultados del modelo (salida ordenada y didáctica)
disp("-------------------------------------------------------");
disp("Resultados del modelo del motor:");
fprintf("  Ganancia del motor K_M = %.6g\n", ganancia_motor);
fprintf("  Constante de tiempo tau = %.6g s\n", constante_tiempo);

% -------------------- RESPUESTA AL ESCALÓN (igual que tu original) ----------------------------------------------------------------
tiempo_final = 5 * constante_tiempo;
if tiempo_final == 0
    tiempo_final = 1; 
end
vector_tiempo = 0 : (tiempo_final / 500) : tiempo_final;
respuesta_velocidad = ganancia_motor * (1 - exp(-vector_tiempo / constante_tiempo));

% Puntos para marcar en la gráfica
valor_final_esperado = ganancia_motor;                     
valor_en_constante_tiempo = 0.632 * ganancia_motor;        
tiempo_de_asentamiento = 4 * constante_tiempo;             

% -------------------- GRAFICA -----------------------------------------------------------------------------
figure('Name', 'Simulador de Motor de CD', 'NumberTitle', 'off');
hold on;
plot(vector_tiempo, respuesta_velocidad, 'k-', 'LineWidth', 2, 'DisplayName', 'Respuesta y(t)');
line([0 tiempo_final], [valor_final_esperado valor_final_esperado], 'Color', 'r', 'LineStyle', '--', 'LineWidth', 1.2, 'DisplayName', 'Valor final (5\tau)');
plot(constante_tiempo, valor_en_constante_tiempo, 'ro', 'MarkerSize', 7, 'MarkerFaceColor', 'r', 'DisplayName', 't = \tau (63.2%)');
[~, indice_asentamiento] = min(abs(vector_tiempo - tiempo_de_asentamiento));
plot(tiempo_de_asentamiento, respuesta_velocidad(indice_asentamiento), 'blue^', 'MarkerSize', 7, 'MarkerFaceColor', 'b', 'DisplayName', 'Tiempo Asentamiento (2%)');
hold off;
grid on;
title(sprintf('G(s) = %.3f / (%.3fs + 1)', ganancia_motor, constante_tiempo), 'FontName', 'Times New Roman');
xlabel('Tiempo  (s)', 'FontName', 'Times New Roman');
ylabel('Velocidad  ', 'FontName', 'Times New Roman');
legend('Location', 'southeast', 'FontSize', 10);

disp("Fin de la simulación del Proyecto 1.");
disp("-------------------------------------------------------");

% --------------------------------------- INICIO PROYECTO 2 (explicado) ------------------------------------------------------------
disp(" ");
disp("=======================================================");
disp("Ahora continuamos con el Proyecto 2: Routh-Hurwitz y Root Locus");
disp("=======================================================");
disp("Según la especificación, el script debe solicitar ceros y polos de G(s).");
disp("Puedes elegir usar la planta del motor calculada arriba o ingresar ceros/polos manualmente.");
disp(" ");

% Opción para usar la planta del motor o ingresar ceros/polos
disp("Elija la opción para definir la planta G(s):");
disp("  1 - Usar la planta del motor (G(s) = K_M / (tau s + 1))");
disp("  2 - Ingresar ceros y polos manualmente (ejemplo: [0 -2] y [-1 -3 -5])");
opcion = input('Ingrese 1 o 2: ');

switch opcion
    case 1
        % Construir G(s) a partir de K_M y tau (planta del motor)
        numerador_planta = ganancia_motor;
        denominador_planta = [constante_tiempo 1];
        funcion_transferencia_lazo_abierto = tf(numerador_planta, denominador_planta);
        disp("Has elegido usar la planta del motor calculada.");
    case 2
        % Pedir ceros y polos al usuario (cumple la especificación del proyecto 2)
        disp("Ingrese los ceros y polos como vectores en MATLAB (usar corchetes).");
        ceros_usuario = input('Ingrese los ceros de G(s) como vector (ejemplo: [0 -2]): ');
        polos_usuario = input('Ingrese los polos de G(s) como vector (ejemplo: [-1 -3 -5]): ');
        if isempty(polos_usuario)
            error('Debe ingresar al menos un polo para definir la planta.');
        end
        numerador_planta = poly(ceros_usuario);   % convierte ceros a polinomio
        denominador_planta = poly(polos_usuario); % convierte polos a polinomio
        funcion_transferencia_lazo_abierto = tf(numerador_planta, denominador_planta);
        disp("Has elegido ingresar ceros y polos manualmente.");
    otherwise
        error('Opción inválida. Ejecute de nuevo y elija 1 o 2.');
end

% --------------------------------------- MOSTRAR G(s) DE FORMA LIMPIA -------------------------------------------------------------
disp("-------------------------------------------------------");
disp("FUNCIÓN DE TRANSFERENCIA EN LAZO ABIERTO G(s):");
[numG, denG] = tfdata(funcion_transferencia_lazo_abierto, 'v'); % vectores num/den
fprintf("  Numerador (coeficientes): "); disp(numG);
fprintf("  Denominador (coeficientes): "); disp(denG);

% -------------------- CONSTRUCCIÓN ECUACIÓN CARACTERÍSTICA ---------------
% Explicación breve: para lazo cerrado con realimentación unitaria la ecuación característica es:
% 1 + K*G(s) = 0  -> multiplicando por denG(s): denG(s) + K*numG(s) = 0
% Para análisis numérico tomamos K = 1 (se puede extender si se desea)
K_analisis = 1;

% Alinear longitudes de vectores para sumar denG + K*numG
lenD = length(denG);
lenN = length(numG);
if lenD > lenN
    numG_padded = [zeros(1, lenD - lenN), numG];
    coeficientes_ecuacion_caracteristica = denG + K_analisis * numG_padded;
elseif lenN > lenD
    denG_padded = [zeros(1, lenN - lenD), denG];
    coeficientes_ecuacion_caracteristica = denG_padded + K_analisis * numG;
else
    coeficientes_ecuacion_caracteristica = denG + K_analisis * numG;
end

disp("-------------------------------------------------------");
disp("ECUACIÓN CARACTERÍSTICA (con K = 1):");
fprintf("  Coeficientes (orden descendente): "); disp(coeficientes_ecuacion_caracteristica);

% --------------------------------------- TABLA DE ROUTH-HURWITZ  ----------------------------------------------
disp("---------------------------------------------------------------------------------------------");
disp("Construyendo la tabla de Routh-Hurwitz...");
tabla_routh = routh_table(coeficientes_ecuacion_caracteristica);

% Imprimir la tabla fila por fila de forma clara y explicar cada fila
disp("Tabla de Routh-Hurwitz (fila por fila) y su interpretación:");
for i = 1:size(tabla_routh,1)
    fprintf("Fila %d: ", i);
    for j = 1:size(tabla_routh,2)
        fprintf('%12.6g', tabla_routh(i,j));
    end
    % Explicación didáctica de cada fila (texto breve)
    if i == 1
        fprintf('   <--------------------- Fila 1: coeficientes de los términos de mayor grado (s^n, s^{n-2}, ...)\n');
    elseif i == 2
        fprintf('   <--------------------- Fila 2: coeficientes siguientes (s^{n-1}, s^{n-3}, ...)\n');
    else
        fprintf('   <--------------------- Fila %d: calculada a partir de las dos filas anteriores\n', i);
    end
end

% Interpretación automática: revisar signos en la primera columna
primera_columna = tabla_routh(:,1);

% Aviso si hay ceros exactos en la primera columna (caso especial)
if any(abs(primera_columna) < eps)
    disp("Nota: La primera columna contiene ceros (o valores muy pequeños). Este caso requiere tratamiento especial en Routh (fila de ceros o sustitución por epsilon). En esta versión se aplica un epsilon pequeño para continuar el cálculo.");
end

% Contar cambios de signo en la primera columna (ignorando ceros exactos)
signos = sign(primera_columna);
% Reemplazar ceros por el signo del elemento siguiente para conteo aproximado
for k = 1:length(signos)-1
    if signos(k) == 0
        signos(k) = signos(k+1);
    end
end
num_cambios_signo = sum(diff(signos) ~= 0);

% Resultado interpretado
if all(primera_columna > 0)
    disp(" Interpretación: El sistema es ESTABLE (no hay cambios de signo en la primera columna).");
else
    fprintf(" Interpretación: El sistema tiene %d cambio(s) de signo en la primera columna -> indica %d polo(s) en el semiplano derecho (inestabilidad).\n", num_cambios_signo, num_cambios_signo);
end

% -------------------- GRAFICAR ROOT LOCUS --------------------------------
disp("-------------------------------------------------------");
disp("Graficando Root Locus de la planta seleccionada...");
figure('Name', 'Root Locus del Sistema', 'NumberTitle', 'off');
rlocus(funcion_transferencia_lazo_abierto);
grid on;
title('Root Locus del sistema', 'FontName', 'Times New Roman');

disp("Análisis Proyecto 2 completado.");
disp("Fin del programa.");
disp("-------------------------------------------------------");

end

% -------------------- FUNCION AUXILIAR: routh_table -----------------------
function tabla = routh_table(coeficientes)
    % Construye la tabla de Routh-Hurwitz para un vector de coeficientes
    % coeficientes: vector con coeficientes del polinomio característico (orden descendente)
    % Esta implementación maneja el caso a==0 usando un pequeño epsilon para
    % evitar división por cero y detecta filas de ceros (devuelve ceros en la fila).
    
    n = length(coeficientes);
    m = ceil(n/2);
    tabla = zeros(n, m);

    % Primera fila: coeficientes en posiciones 1,3,5,...
    tabla(1,1:length(coeficientes(1:2:end))) = coeficientes(1:2:end);

    % Segunda fila: coeficientes en posiciones 2,4,6,...
    oddCoeffs = coeficientes(2:2:end);
    tabla(2,1:length(oddCoeffs)) = oddCoeffs;

    % Rellenar el resto de la tabla
    for i = 3:n
        for j = 1:(m-1)
            a = tabla(i-1,1);
            b = tabla(i-2,j+1);
            c = tabla(i-2,1);
            d = tabla(i-1,j+1);
            if abs(a) > eps
                tabla(i,j) = (a * b - c * d) / a;
            else
                % Si a == 0, usamos un pequeño epsilon para continuar (versión didáctica)
                eps_val = 1e-6;
                tabla(i,j) = (eps_val * b - c * d) / eps_val;
            end
        end
    end
end
