function proyecto2_routh_rootlocus
% Codigo de simulación para el proyecto 1 y proyecto 2
% ----------------------------------------------------------------------------------------- PROYECTO 1 --------------------------------
disp("_______________________________________________________");
disp("                                                       ");
disp("                 SIMULADOR DE MOTOR DE CD              ");
disp("_______________________________________________________");

disp("Ingresa los siguientes datos para la generación del grafico");
disp("                                                       ");

% Entrada de parámetros
constante_par = input('Ingrese la Constante de par [N.m/A]: ');
resistencia_armadura = input('Ingrese la Resistencia de armadura [Ohms]: ');
friccion_eje = input('Ingrese la Fricción del eje [N.m.s/rad]: ');
constante_fem = input('Ingrese la Constante fem [V.s/rad]: ');
momento_inercia = input('Ingrese el Momento de inercia [kg.m^2]: ');

% Validaciones
if resistencia_armadura <= 0 || momento_inercia <= 0
    error('Error :c : No es posible hacerlo con esos datos, ingresa datos nuevos, porfavor. Nota: Se debe a que la resistencia y la inercia deben ser mayores a cero. :(');
end
if constante_par < 0 || constante_fem < 0 || friccion_eje < 0
    error('Error :c : No es posible hacerlo con esos datos, ingresa datos nuevos, por favor. Nota: Se debe a que los parámetros no pueden ser negativos.');
end

% Cálculos
denominador_comun = (resistencia_armadura * friccion_eje) + (constante_par * constante_fem);
if denominador_comun == 0
    error('Error :c : No es posible hacerlo con esos datos, ingresa datos nuevos. El denominador común es cero.');
end
ganancia_motor = constante_par / denominador_comun;
constante_tiempo = (resistencia_armadura * momento_inercia) / denominador_comun;

% Vector de tiempo y respuesta
tiempo_final = 5 * constante_tiempo;
if tiempo_final == 0, tiempo_final = 1; end
vector_tiempo = 0 : (tiempo_final / 500) : tiempo_final;
respuesta_velocidad = ganancia_motor * (1 - exp(-vector_tiempo / constante_tiempo));

% Puntos en la gráfica
valor_final_esperado = ganancia_motor;                     
valor_en_constante_tiempo = 0.632 * ganancia_motor;        
tiempo_de_asentamiento = 4 * constante_tiempo;             

% Gráfica
figure('Name', 'Simulador de Motor de CD', 'NumberTitle', 'off');
hold on;
plot(vector_tiempo, respuesta_velocidad, 'k-', 'LineWidth', 2, 'DisplayName', 'Respuesta y(t)');
line([0 tiempo_final], [valor_final_esperado valor_final_esperado], 'Color', 'r', 'LineStyle', '--', 'LineWidth', 1.2, 'DisplayName', 'Valor final (5\tau)');
plot(constante_tiempo, valor_en_constante_tiempo, 'ro', 'MarkerSize', 7, 'MarkerFaceColor', 'r', 'DisplayName', 't = \tau (63.2%)');
[~, indice_asentamiento] = min(abs(vector_tiempo - tiempo_de_asentamiento));
plot(tiempo_de_asentamiento, respuesta_velocidad(indice_asentamiento), 'blue^', 'MarkerSize', 7, 'MarkerFaceColor', 'b', 'DisplayName', 'Tiempo Asentamiento (2%)');
hold off;
grid on;
title(sprintf('G(s) = %.3f / (%.3fs + 1)', ganancia_motor, constante_tiempo), 'FontName', 'Times New Roman');
xlabel('Tiempo  (s)', 'FontName', 'Times New Roman');
ylabel('Velocidad  ', 'FontName', 'Times New Roman');
legend('Location', 'southeast', 'FontSize', 10);

disp("Fin de la simulación c:");
disp("-------------------------------------------------------");

% ----------------------------------------------------------------------------------------------------------- PROYECTO 2 --------------------------------
disp("_______________________________________________________________________________");
disp("       Proyecto 2 - crear grafica y tabla: Routh-Hurwitz y Root Locus          ");
disp("_______________________________________________________________________________");

% Opción: usar planta del motor o ingresar ceros/polos
opcion = input('Hola! Bienvenido Ingrese 1 para usar la planta del motor, 2 para ingresar ceros/polos: ');

if opcion == 1
    numG = ganancia_motor;
    denG = [constante_tiempo 1];
    G = tf(numG, denG);
else
    ceros_usuario = input('Ingrese los ceros de G(s) como vector: ');
    polos_usuario = input('Ingrese los polos de G(s) como vector: ');
    numG = poly(ceros_usuario);
    denG = poly(polos_usuario);
    G = tf(numG, denG);
end

disp("Función de transferencia en lazo abierto G(s):");
disp(G);

% Ecuación característica con K=1
K = 1;
lenD = length(denG); lenN = length(numG);
if lenD > lenN
    numG = [zeros(1,lenD-lenN) numG];
elseif lenN > lenD
    denG = [zeros(1,lenN-lenD) denG];
end
char_poly = denG + K*numG;

disp("Coeficientes de la ecuación característica:");
disp(char_poly);

% Tabla de Routh-Hurwitz
tabla = routh_table(char_poly);
disp("Tabla de Routh-Hurwitz:");
disp(tabla);

% Interpretación básica
if all(tabla(:,1) > 0)
    disp("El sistema es ESTABLE c: ");
else
    disp("El sistema es INESTABLE :c ");
end

% Root Locus
figure('Name','Root Locus','NumberTitle','off');
rlocus(G); grid on;
title('Root Locus del sistema');

end

% ----------------------------------------------------------------------------------------------- routh_table -----------------------
function tabla = routh_table(coeficientes)
    n = length(coeficientes);
    m = ceil(n/2);
    tabla = zeros(n, m);

    % Primera fila: coeficientes en posiciones 1,3,5,...
    tabla(1,1:length(coeficientes(1:2:end))) = coeficientes(1:2:end);

    % Segunda fila: coeficientes en posiciones 2,4,6,...
    oddCoeffs = coeficientes(2:2:end);
    tabla(2,1:length(oddCoeffs)) = oddCoeffs;

    % Rellenar el resto de la tabla
    for i = 3:n
        for j = 1:(m-1)
            a = tabla(i-1,1);
            b = tabla(i-2,j+1);
            c = tabla(i-2,1);
            d = tabla(i-1,j+1);
            if a ~= 0
                tabla(i,j) = (a * b - c * d) / a;
            else
                tabla(i,j) = 0;
            end
        end
    end
end
